# Read-only Postgres role (SELECT-only grants — see docs/ARCHITECTURE.md's
# "ML integration boundary"). Created via:
#   docker exec satps-postgres psql -U satps -d satps -c "CREATE ROLE satps_ml WITH LOGIN PASSWORD '...'; GRANT CONNECT ON DATABASE satps TO satps_ml; GRANT USAGE ON SCHEMA public TO satps_ml; GRANT SELECT ON ALL TABLES IN SCHEMA public TO satps_ml;"
DATABASE_URL="postgres://satps_ml:satps_ml_readonly_dev_pw@localhost:5434/satps"

# Shared secret the Next.js app presents on every request to this service
# (must match apps/web/.env.local's ML_SERVICE_TOKEN).
ML_SERVICE_TOKEN="change-me-dev-token"
