{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file=.env.local ../../node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ../../node_modules/.bin/drizzle-kit migrate",
    "db:push": "node --env-file=.env.local ../../node_modules/.bin/drizzle-kit push",
    "db:studio": "node --env-file=.env.local ../../node_modules/.bin/drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local lib/db/seed.ts",
    "auth:generate": "npx @better-auth/cli generate --config lib/auth.ts --output lib/db/auth-schema.ts -y"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@tabler/icons-react": "^3.44.0",
    "better-auth": "^1.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "motion": "^12.23.24",
    "next": "^16.3.5",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
